# Copy this file to .env and fill in what you use.
# If LIVEKIT_* / GOOGLE_API_KEY are already in ../.env (the original project), they're picked up automatically.

# ---- Core (required) --------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GOOGLE_API_KEY=

# ---- Model / voice (optional) -----------------------------------------
JARVIS_AGENT_NAME=jarvis-pro
JARVIS_MODEL=gemini-3.8-live
JARVIS_VOICE=Aoede
JARVIS_TOOL_MODEL=gemini-3.5-flash,gemini-3.8-flash,gemini-3.5-flash-lite
JARVIS_FAST_TOOL_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.8-flash
JARVIS_TOOL_TIMEOUT_MS=15000
# Latency: silence before JARVIS replies (ms) and 2.5-model thinking (0 = off, fastest)
JARVIS_SILENCE_MS=1000
JARVIS_THINKING_BUDGET=0

# ---- Dashboard (optional) ---------------------------------------------
JARVIS_UI_HOST=127.0.0.1
JARVIS_UI_PORT=8000
JARVIS_UI_PASSWORD=

# ---- Spotify inside the dashboard (optional) --------------------------
# Free keys from https://developer.spotify.com/dashboard (create an app). Without them,
# "play ... on Spotify" opens Spotify outside the dashboard instead.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---- Other project over MCP (capabilities.mcp.servers.project) -----
# Paste the project's MCP URL here when you have it; restart the agent. Token only if it needs one.
PROJECT_MCP_URL=https://lamellose-ailene-spinaceous.ngrok-free.dev/api/v1/mcp
PROJECT_MCP_TOKEN=

# ---- Database reports (capabilities.database) -----------------------
# PostgreSQL, ideally a READ-ONLY login (see README "Database reports")
JARVIS_DB_URL=postgresql://jarvis_ro:CHANGE_ME@localhost:5432/your_database

# ---- Website login checks (capabilities.websites) ---------------------
# TeleDoctor Admin — DEV environment only
TELEDOCTOR_ADMIN_EMAIL=admin@gmail.com
TELEDOCTOR_ADMIN_PASSWORD=Password@123

# ---- Email (capabilities.email) ---------------------------------------
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ---- Phone + customer calls (capabilities.phone / capabilities.customer) ----
# Easiest: fill in the 3 TWILIO_* values, then run `python setup_twilio.py` — it creates the
# Twilio SIP trunk + LiveKit outbound trunk and fills in everything below automatically.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+10000000000
# Optional: your LiveKit SIP URI (LiveKit Cloud > Settings) to also RECEIVE calls
LIVEKIT_SIP_URI=sip:your-project.sip.livekit.cloud
# ST_xxx id from `lk sip outbound create` or setup_twilio.py (Twilio Elastic SIP Trunk — see README 5.4b)
SIP_OUTBOUND_TRUNK_ID=

# ---- X / Twitter (capabilities.social.x) ------------------------------
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ---- Facebook Page + Instagram Business (capabilities.social.facebook / instagram)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v23.0

# ---- LinkedIn (capabilities.social.linkedin) --------------------------
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_ID=

# ---- GiveCharity admin MCP
GIVECHARITY_MCP_URL=
GIVECHARITY_MCP_TOKEN=

# WhatsApp: auto | desktop | web
JARVIS_WHATSAPP_MODE=auto
